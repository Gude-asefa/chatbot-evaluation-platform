# Neon Postgres connection string (use the *pooled* URL with the plain "postgresql://" scheme,
# NOT the "postgresql+psycopg://" form used by the Python app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Admin login. Generate the hash with:  npm run hash-password -- "your-password"
# Same format as the Streamlit app, so the existing hash keeps working.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string that signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
